# Copy to backend/.env and fill in. NEVER commit backend/.env.

PORT=8787
CORS_ORIGIN=http://localhost:5173

SUI_NETWORK=testnet
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443

# Admin wallet - used ONLY by the backend to call register_report / update_treasury.
# Export from the CLI:  sui keytool export --key-identity <your-address>
# Format: a bech32 string starting with "suiprivkey1..."
# Never put this in the frontend or in source control.
ADMIN_SECRET_KEY=

# From `sui client publish` - testnet deploy 2026-09-02 (public ids, safe to keep here).
PACKAGE_ID=0x0047c06a35bf05d6148797eeeeada97d134f64410ff65ed88e8792770df87b9b
CONFIG_ID=0x6df54fa32eff53523793d1ee1fe602076309dbede5803b9e300ffffb11b90c77
ADMIN_CAP_ID=0xa8d9900d8e2f9e2264d229297c97c2e8ccce5383e9da9997527d960e591edb94

# A registered ResearchReport object id (from register_report) for the demo
# purchase flow. Already registered and wired in.
DEMO_REPORT_OBJECT_ID=0xc63fd6d76b573c69dfc54162b6ded41f5601c0354d2276330ae09297505d4a69

# Walrus (decentralized blob store), used via the @mysten/walrus SDK.
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5

# Seal (KMS) - encrypts premium report bodies before they go to Walrus.
# Leave empty on testnet; the Seal SDK resolves the default key servers.
# (If empty, unlock falls back to serving the stored body - see docs/SECURITY.md.)
SEAL_KEY_SERVER_0=
SEAL_KEY_SERVER_1=

# Enoki (zkLogin) - the FRONTEND uses this via frontend/.env.local
# (VITE_ENOKI_API_KEY). Only set here if backend code needs it.
ENOKI_API_KEY=
ENOKI_CLIENT_ID=

# OpenRouter - powers every AI agent (research/analysis/synthesis pipeline AND
# the stablecoin-forecast routes). https://openrouter.ai/keys
# If unset, the AI routes return demo data instead of failing.
OPENROUTER_API_KEY=

# Gonka - writes the daily narrative on /api/forecast/daily (turns scraped
# numbers + headlines into plain English). If unset, that route returns
# clearly-labelled demo text built from the real numbers.
#
# Gonka is reached through a BROKER/gateway, so both the base url and the model
# id depend on which broker you signed up with, and model ids are
# case-sensitive - copy them exactly from your broker's catalogue.
# Base url must include /v1. Examples of broker roots:
#   https://api.gonkarouter.io/v1  |  https://api.gonkagate.com/v1
#   https://gate.joingonka.ai/v1   |  https://gonka-gateway.mingles.ai/v1
GONKA_API_KEY=
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_MODEL=MiniMaxAI/MiniMax-M2.7

# Secret for signing session tokens issued after wallet auth.
AUTH_SESSION_SECRET=dev-only-change-me
