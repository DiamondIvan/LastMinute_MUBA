# Copy to backend/.env and fill in. NEVER commit backend/.env.

PORT=8787
CORS_ORIGIN=http://localhost:5173

SUI_NETWORK=testnet
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443

# Admin wallet — used ONLY by the backend to call register_report / update_treasury.
# Export from the CLI:  sui keytool export --key-identity <your-address>
# Format: a bech32 string starting with "suiprivkey1..."
# Never put this in the frontend or in source control.
ADMIN_SECRET_KEY=

# From `sui client publish` — testnet deploy 2026-09-02 (public ids, safe to keep here).
PACKAGE_ID=0x0047c06a35bf05d6148797eeeeada97d134f64410ff65ed88e8792770df87b9b
CONFIG_ID=0x6df54fa32eff53523793d1ee1fe602076309dbede5803b9e300ffffb11b90c77
ADMIN_CAP_ID=0xa8d9900d8e2f9e2264d229297c97c2e8ccce5383e9da9997527d960e591edb94

# A registered ResearchReport object id (from `register_report`) for the demo
# purchase flow. Fill in after running the sui client call in the repo README.
DEMO_REPORT_OBJECT_ID=0xc63fd6d76b573c69dfc54162b6ded41f5601c0354d2276330ae09297505d4a69

# Walrus testnet HTTP publisher/aggregator (no auth needed on testnet).
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5

# Anthropic API key for the research/analysis/synthesis agents.
# Read automatically by the Anthropic SDK (dotenv loads it into the process env).
ANTHROPIC_API_KEY=

# Secret for signing session tokens issued after wallet auth.
AUTH_SESSION_SECRET=dev-only-change-me
