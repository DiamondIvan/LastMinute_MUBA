# Copy to backend/.env and fill in. NEVER commit backend/.env.

SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Admin wallet — used ONLY by the backend to call register_report / update_treasury.
# Never put this in the frontend or in source control.
ADMIN_PRIVATE_KEY=

# From `sui client publish` output:
PACKAGE_ID=
CONFIG_ID=
ADMIN_CAP_ID=

# Walrus (testnet). Fill in once you pick a publisher/aggregator or use the SDK.
WALRUS_PUBLISHER=
WALRUS_AGGREGATOR=

# AI provider key(s) for the research agents.
AI_API_KEY=
